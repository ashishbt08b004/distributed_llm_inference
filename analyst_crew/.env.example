# Copy to .env (never commit it). run.py reads it; real env vars win.

# --- Blueprint 1 cluster, through the LiteLLM gateway (`./scripts/laptop.sh tunnel` in blueprint1/)
LLM_MODEL=hosted_vllm/qwen7b
LLM_BASE_URL=http://localhost:4000/v1
# On the node: grep LITELLM_MASTER_KEY ~/blueprint1/.secrets.env
LLM_API_KEY=sk-...

# --- Or any other OpenAI-compatible endpoint with tool calling, e.g. local Ollama:
# LLM_MODEL=ollama/qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1

# Sampling: Qwen2.5's recommended style. Pure greedy (temperature 0) sent the 7B model
# into repetition loops and broken tool calls on the first cluster run.
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.8
LLM_TOP_K=20
LLM_REPETITION_PENALTY=1.05
LLM_MAX_TOKENS=1024      # per LLM call
LLM_TIMEOUT=300          # seconds; a request may wait in the router's admission queue
AGENT_MAX_ITER=15        # tool-loop steps per agent (3 agents per run)
GUARDRAIL_RETRIES=2      # times a task is redone after its output is rejected (text tool call, no SQL, no FINAL_ANSWER)
