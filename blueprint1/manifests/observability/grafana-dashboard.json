{
 "title": "Blueprint 1 \u2014 Inference stack",
 "uid": "bp1-inference",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "tags": [
  "blueprint1",
  "vllm"
