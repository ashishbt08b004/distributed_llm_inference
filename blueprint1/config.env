# =============================================================================
# Blueprint 1 — single-node H100 inference stack: central configuration.
# Every script sources this file (with `set -a`, so everything is exported).
# Edit here, not in the manifests — the manifests are templates rendered from it.
# =============================================================================

# ---- Required secrets -------------------------------------------------------
# Leave HF_TOKEN empty here and `export HF_TOKEN=hf_...` in your shell instead,
# so the token never lands in a file you might commit.
HF_TOKEN="${HF_TOKEN:-}"
# Gateway API key. A random one is generated into .secrets.env on first run if unset.
LITELLM_MASTER_KEY="${LITELLM_MASTER_KEY:-}"

# ---- Model ------------------------------------------------------------------
MODEL_ID="Qwen/Qwen2.5-7B-Instruct"
SERVED_MODEL_NAME="qwen7b"
# 16k so multi-step agents (../analyst_crew) fit: system prompt + tool schemas +
# 15-40 tool results. Qwen2.5-7B KV is ~56 KB/token, so one 16k sequence needs
# ~0.9 GB of the ~2.5 GB KV pool in a 14 GB FP8 slice. The random 512/128
# benchmarks are unaffected. Drop back to 4096 if a slice won't start.
MAX_MODEL_LEN=16384
# Qwen2.5-7B is ~15.2 GB in BF16, which does NOT fit in the blueprint's 12-15 GB
# HAMi slices. FP8 (native on H100) brings weights to ~8.7 GB. Set to "" for BF16
# (and then raise the *_GPUMEM slices to >= 20480 and drop to fewer pods).
QUANTIZATION="fp8"
GPU_MEM_UTIL=0.90          # fraction of the *HAMi slice* (HAMi virtualises cudaMemGetInfo)
MAX_NUM_SEQS=64            # keeps CUDA-graph capture memory small inside a slice
# Appended verbatim to `vllm serve`, e.g. add "--enforce-eager" if a slice is tight.
# The tool-call flags let Qwen2.5 return OpenAI-style `tool_calls` (needed by
# ../analyst_crew and any function-calling client). They don't affect plain completions.
VLLM_EXTRA_ARGS="--enable-auto-tool-choice --tool-call-parser hermes"

# ---- Images / versions (verified against PyPI / Docker Hub, Sep 2026) --------
# lmcache/vllm-openai ships vLLM + LMCache built against each other. We add Mooncake on top.
# CUDA 13 throughout -> needs NVIDIA driver >= 580. NOT the -cu129 tag: it pairs a
# CUDA 13 vLLM 0.29 (unpinned PyPI wheel) with a CUDA 12.9 torch and crashes at pod
# start with "libcudart.so.13: cannot open shared object file". image/check_cuda.py
# now fails the build on such a mismatch.
BASE_IMAGE="lmcache/vllm-openai:v0.5.5"
MOONCAKE_PIP_VERSION="0.3.13.post1"               # the Dockerfile picks the -cuda13 wheel to match
APP_IMAGE="bp1/vllm-lmcache-mooncake:0.2"          # built locally in phase 4, imported into k3s
SGLANG_ROUTER_VERSION="0.3.2"
ROUTER_PY_IMAGE="python:3.12-slim"
LITELLM_IMAGE="ghcr.io/berriai/litellm:main-stable"
CUDA_TEST_IMAGE="nvidia/cuda:12.9.1-base-ubuntu22.04"
# Helm chart versions: empty = latest from the repo.
GPU_OPERATOR_CHART_VERSION=""
HAMI_CHART_VERSION=""
KPS_CHART_VERSION=""

# ---- GPU slices (HAMi) ------------------------------------------------------
# Totals must stay <= 81920 MB and <= 100 cores.  2*16384 + 3*14336 = 75776 MB, 2*25 + 3*15 = 95 %.
PREFILL_REPLICAS=2
PREFILL_GPUMEM=16384
PREFILL_GPUCORES=25
DECODE_REPLICAS=3
DECODE_GPUMEM=14336
DECODE_GPUCORES=15
# Config A (baseline single pod). Default = the same slice as one decode pod.
SINGLE_GPUMEM=14336
SINGLE_GPUCORES=15

# ---- KV tier: LMCache + Mooncake ------------------------------------------------
MOONCAKE_STORE_GB=32                 # DRAM the dedicated store pod contributes to the pool
MOONCAKE_ENABLE_OFFLOAD="true"       # spill evicted objects to NVMe (store pod /data)
MOONCAKE_CLIENT_SEGMENT_GB=1         # DRAM each vLLM pod contributes (keep small)
LMCACHE_CHUNK_SIZE=256
LMCACHE_LOCAL_CPU_GB=4               # per-pod CPU-RAM tier in front of Mooncake
ENABLE_KV_TIER_C="true"              # "false" = config C without LMCache/Mooncake (debug fallback)

# ---- Routing ----------------------------------------------------------------
# Router used for config B: "sglang" (sglang_router, as in the blueprint) or
# "kv" (the bundled kv_router.py, which also does P/D orchestration for config C).
ROUTER_IMPL_B="sglang"
# kv_router admission queue. Each decode pod gets at most this many requests
# (matching vLLM's MAX_NUM_SEQS keeps its own waiting queue near empty); the
# rest wait in one bounded FIFO in the router. 0 = no cap, no queue.
ROUTER_MAX_INFLIGHT_PER_WORKER="${MAX_NUM_SEQS}"
ROUTER_QUEUE_MAX=512       # beyond this the router answers 429 (keep > BENCH_NUM_PROMPTS)
ROUTER_QUEUE_TIMEOUT=120   # seconds a request may wait before a 503

# ---- Host paths (Lambda: /home/ubuntu sits on the large local NVMe) -----------
HOST_DATA_DIR="/home/ubuntu"
HF_CACHE_DIR="${HOST_DATA_DIR}/hf-cache"
VLLM_CACHE_DIR="${HOST_DATA_DIR}/vllm-cache"
MOONCAKE_DIR="${HOST_DATA_DIR}/mooncake-storage"
BENCH_DIR="${HOST_DATA_DIR}/bench"

# ---- Benchmark grid ---------------------------------------------------------
BENCH_CONFIGS="A B C"
BENCH_RATES="1 8 inf"
BENCH_NUM_PROMPTS=200
BENCH_INPUT_LEN=512
BENCH_OUTPUT_LEN=128
MT_SESSIONS=50
MT_TURNS=5
MT_SESSION_RATE=2          # new sessions per second (Poisson)
RUN_SHAREGPT="false"       # optional 5th pattern from the blueprint (vllm bench sharegpt)

# ---- Laptop side --------------------------------------------------------------
LAMBDA_IP="${LAMBDA_IP:-}"
SSH_KEY="${SSH_KEY:-$HOME/.ssh/lambda_key}"
REMOTE_REPO_DIR="/home/ubuntu/blueprint1"
